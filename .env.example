# Copy this file to .env. Never commit the resulting .env file.
# Generate secrets independently for every environment, for example:
#   openssl rand -base64 48

POSTGRES_DB=knowledge_base
POSTGRES_USER=knowledge_base_app
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_PORT=5432

BACKEND_PORT=8080
BACKEND_HOST_PORT=8080
FRONTEND_CONTAINER_PORT=3000
FRONTEND_HOST_PORT=3000

APP_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_AUTH_COOKIE_NAME=knowledge-base-session
APP_AUTH_COOKIE_MAX_AGE=604800
APP_AUTH_SECURE_COOKIE=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used only by the optional frontend fuzz command.
FRONTEND_BASE_URL=http://localhost:3000
